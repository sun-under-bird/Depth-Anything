        "20",
        "--input-size",
        "322",
        "--device",
        "auto",
        "--resize-width",
        "640",
        "--resize-height",
        "480",
        "--max-frames",
        "0",
        "--warmup-frames",
        "5",
        "--show",
        "--preview-mode",
        "combined",
        "--preview-normalize",
        "fixed",
        "--depth-hud"
      ]
    },
    {
      "name": "Depth Anything: Camera Live Preview",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/Depth-Anything-V2/metric_depth/benchmark_video_fps.py",
      "cwd": "${workspaceFolder}/Depth-Anything-V2",
      "python": "${workspaceFolder}/Depth-Anything-V2/.venv/Scripts/python.exe",
      "console": "integratedTerminal",
      "redirectOutput": true,
      "justMyCode": true,
      "args": [
        "--source",
        "0",
        "--encoder",
        "vits",
        "--load-from",
        "metric_depth/checkpoints/depth_anything_v2_metric_hypersim_vits.pth",
        "--max-depth",
        "20",
        "--input-size",
        "322",
        "--device",
        "auto",
        "--camera-width",
        "640",
        "--camera-height",
        "480",
        "--camera-fps",
