    },
    {
      "name": "Depth Anything: Image To Point Cloud",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/Depth-Anything-V2/metric_depth/depth_to_pointcloud.py",
      "cwd": "${workspaceFolder}/Depth-Anything-V2",
      "python": "${workspaceFolder}/Depth-Anything-V2/.venv/Scripts/python.exe",
      "console": "integratedTerminal",
      "redirectOutput": true,
      "justMyCode": true,
      "args": [
        "--encoder",
        "vits",
        "--load-from",
        "metric_depth/checkpoints/depth_anything_v2_metric_hypersim_vits.pth",
        "--max-depth",
        "20",
        "--img-path",
        "assets/examples/demo01.jpg",
        "--outdir",
        "metric_depth/outputs_pointcloud",
        "--input-size",
        "518",
        "--device",
        "auto",
        "--focal-length-x",
        "470.4",
        "--focal-length-y",
        "470.4",
        "--voxel-size",
        "0.02",
        "--max-points",
        "300000",
        "--save-html",
        "--open-html",
        "--html-max-points",
