{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Depth Anything: Test Video FPS",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/Depth-Anything-V2/metric_depth/benchmark_video_fps.py",
      "cwd": "${workspaceFolder}/Depth-Anything-V2",
      "python": "${workspaceFolder}/Depth-Anything-V2/.venv/Scripts/python.exe",
      "console": "integratedTerminal",
      "redirectOutput": true,
      "justMyCode": true,
      "args": [
        "--source",
        "assets/examples_video/basketball.mp4",
        "--encoder",
        "vits",
        "--load-from",
        "metric_depth/checkpoints/depth_anything_v2_metric_hypersim_vits.pth",
        "--max-depth",
        "20",
        "--input-size",
        "322",
        "--device",
        "auto",
        "--resize-width",
        "640",
        "--resize-height",
        "480",
        "--max-frames",
        "60",
        "--warmup-frames",
        "5"
      ]
    },
    {
      "name": "Depth Anything: Save Video Preview",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/Depth-Anything-V2/metric_depth/benchmark_video_fps.py",
      "cwd": "${workspaceFolder}/Depth-Anything-V2",
      "python": "${workspaceFolder}/Depth-Anything-V2/.venv/Scripts/python.exe",
      "console": "integratedTerminal",
      "redirectOutput": true,
      "justMyCode": true,
      "args": [
        "--source",
        "assets/examples_video/basketball.mp4",
        "--encoder",
        "vits",
        "--load-from",
        "metric_depth/checkpoints/depth_anything_v2_metric_hypersim_vits.pth",
        "--max-depth",
        "20",
        "--input-size",
        "322",
        "--device",
        "auto",
        "--resize-width",
        "640",
        "--resize-height",
        "480",
        "--max-frames",
        "60",
        "--warmup-frames",
        "5",
        "--save-preview",
        "metric_depth/outputs_video_preview/basketball_preview.mp4",
        "--preview-mode",
        "combined",
        "--depth-hud"
      ]
    },
    {
      "name": "Depth Anything: Video Visualization",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/Depth-Anything-V2/metric_depth/benchmark_video_fps.py",
      "cwd": "${workspaceFolder}/Depth-Anything-V2",
      "python": "${workspaceFolder}/Depth-Anything-V2/.venv/Scripts/python.exe",
      "console": "integratedTerminal",
      "redirectOutput": true,
      "justMyCode": true,
      "args": [
        "--source",
        "assets/examples_video/basketball.mp4",
        "--encoder",
        "vits",
        "--load-from",
        "metric_depth/checkpoints/depth_anything_v2_metric_hypersim_vits.pth",
