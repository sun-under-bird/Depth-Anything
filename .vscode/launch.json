{
  "version": "0.2.0",
  "configurations": [
    
    {
      "name": "Depth Anything: 测试视频FPS",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/Depth-Anything-V2/metric_depth/benchmark_video_fps.py",
      "cwd": "${workspaceFolder}/Depth-Anything-V2",
      "python": "${workspaceFolder}/Depth-Anything-V2/.venv/Scripts/python.exe",
      "console": "internalConsole",
      "redirectOutput": true,
      "justMyCode": true,
      "args": [
        "--source",
        "assets/examples_video/basketball.mp4",
        "--encoder",
        "vits",
        "--load-from",
        "metric_depth/checkpoints/depth_anything_v2_metric_hypersim_vits.pth",
        "--max-depth",
        "20",
        "--input-size",
        "322",
        "--device",
        "auto",
        "--resize-width",
        "640",
        "--resize-height",
        "480",
        "--max-frames",
        "60",
        "--warmup-frames",
        "5"
      ]
    },
    {
      "name": "Depth Anything: 运行示例图",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/Depth-Anything-V2/metric_depth/run.py",
      "cwd": "${workspaceFolder}/Depth-Anything-V2",
      "python": "${workspaceFolder}/Depth-Anything-V2/.venv/Scripts/python.exe",
      "console": "internalConsole",
      "redirectOutput": true,
      "justMyCode": true,
      "args": [
        "--encoder",
        "vits",
        "--load-from",
        "metric_depth/checkpoints/depth_anything_v2_metric_hypersim_vits.pth",
        "--max-depth",
        "20",
        "--img-path",
        "assets/examples/demo01.jpg",
        "--outdir",
        "metric_depth/outputs_demo",
        "--input-size",
        "518",
        "--device",
        "auto",
        "--save-numpy",
        "--pred-only"
      ]
    },
    {
      "name": "Depth Anything: 保存视频预览",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/Depth-Anything-V2/metric_depth/benchmark_video_fps.py",
      "cwd": "${workspaceFolder}/Depth-Anything-V2",
      "python": "${workspaceFolder}/Depth-Anything-V2/.venv/Scripts/python.exe",
      "console": "integratedTerminal",
      "redirectOutput": true,
      "justMyCode": true,
      "args": [
        "--source",
        "assets/examples_video/basketball.mp4",
        "--encoder",
        "vits",
        "--load-from",
        "metric_depth/checkpoints/depth_anything_v2_metric_hypersim_vits.pth",
        "--max-depth",
        "20",
        "--input-size",
        "322",
        "--device",
        "auto",
        "--resize-width",
        "640",
        "--resize-height",
        "480",
        "--max-frames",
        "60",
        "--warmup-frames",
        "5",
        "--save-preview",
        "metric_depth/outputs_video_preview/basketball_preview.mp4",
        "--preview-mode",
        "combined",
        "--depth-hud"
      ]
    },
    {
      "name": "Depth Anything: 摄像头实时预览",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/Depth-Anything-V2/metric_depth/benchmark_video_fps.py",
      "cwd": "${workspaceFolder}/Depth-Anything-V2",
      "python": "${workspaceFolder}/Depth-Anything-V2/.venv/Scripts/python.exe",
      "console": "integratedTerminal",
      "redirectOutput": true,
      "justMyCode": true,
      "args": [
        "--source",
        "0",
        "--encoder",
        "vits",
        "--load-from",
        "metric_depth/checkpoints/depth_anything_v2_metric_hypersim_vits.pth",
        "--max-depth",
        "20",
        "--input-size",
        "322",
        "--device",
        "auto",
        "--camera-width",
        "640",
        "--camera-height",
        "480",
        "--camera-fps",
        "30",
        "--max-frames",
        "0",
        "--warmup-frames",
        "5",
        "--show",
        "--preview-mode",
        "combined",
        "--depth-hud"
      ]
    }
  ]
}
